<!DOCTYPE html>
<html lang="{{ site.language }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="{{ site.themeColor }}"/>
        <meta name="monetization" content="$ilp.uphold.com/96QFDLnaPa42" />

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preconnect" href="https://cdn.heapanalytics.com">
        <link rel="preconnect" href="https://www.googletagmanager.com">
        <link rel="preconnect" href="https://cdn.jsdelivr.net">

        <link rel="preload"
              href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Fira+Code:wght@400;500;600&display=swap"
              as="style"
              onload="this.onload=null;this.rel='stylesheet'"
        />
        <noscript>
          <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet">
        </noscript>

        {% include "partials/meta-head.njk" %}

        {% set headjs %}
        {% include "assets/js/head.js" %}
        {% endset %}
        <script>
            {{ headjs | jsmin | safe }}
        </script>

        {% set css %}
        {% include "assets/css/normalize.css" %}
        {% include "assets/css/variables.css" %}
        {% include "assets/css/app.css" %}
        {% if css.length > 0 %}
            {% for file in css %}
                {% include "assets/css/" + file + ".css" %}
            {% endfor %}
        {% endif %}
        {% endset %}
        <style>
            {{ css | cssmin | safe }}
        </style>
    </head>
    <body
        data-route="{{ route or 'home' }}"
        data-status-path="{{ statusPath or '~/posts' }}"
    >
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.analytics.gtm }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

        <a href="#main-content" class="SkipContent">Skip to main content</a>

        <div class="DotGrid" aria-hidden="true"></div>
        <div class="ReadingProgress" aria-hidden="true"><span></span></div>

        <div class="Container">
            {% include "partials/header.njk" %}
            <main id="main-content" class="Content fade-in" tabindex="-1">
                {% block content %}{% endblock content %}
            </main>
            {% include "partials/footer.njk" %}
        </div>

        {# Command palette modal #}
        <div class="Palette" id="palette" role="dialog" aria-modal="true" aria-label="Command palette">
            <div class="Palette-Box">
                <div class="Palette-InputRow">
                    <span class="chev">›</span>
                    <input id="palette-input" class="Palette-Input" type="text" placeholder="Search posts, jump anywhere…" autocomplete="off" />
                    <span class="Palette-Esc">ESC</span>
                </div>
                <div class="Palette-List" id="palette-list" role="listbox"></div>
                <div class="Palette-Foot">
                    <span>↑↓ navigate</span>
                    <span>↵ open</span>
                    <span>esc close</span>
                    <span class="spacer"></span>
                    <span id="palette-count">0 results</span>
                </div>
            </div>
        </div>

        {# Palette hint (auto-fades on first open) #}
        <div class="PaletteHint" id="palette-hint">
            <kbd class="kbd">⌘K</kbd>
            <span>command palette</span>
        </div>

        {# Vim-style status bar #}
        <div class="StatusBar" id="status-bar">
            <span class="StatusBar-Mode">— NORMAL —</span>
            <span class="StatusBar-Cell path" id="status-path">~/posts</span>
            <span class="StatusBar-Cell hide-narrow" id="status-count"></span>
            <span class="StatusBar-Spacer"></span>
            <span class="StatusBar-Cell StatusBar-Palette" id="status-open-palette" title="Open command palette">
                <kbd class="kbd">⌘K</kbd>
                <span class="hide-narrow">palette</span>
            </span>
            <span class="StatusBar-Cell hide-narrow">utf-8</span>
            <span class="StatusBar-Cell" id="status-theme">dark</span>
            <span class="StatusBar-Cell time" id="status-time">00:00</span>
        </div>

        {% set js %}
        {% include "assets/js/instant.js" %}
        {% include "assets/js/app.js" %}
        {% if js.length > 0 %}
            {% for file in js %}
                {% include "assets/js/" + file + ".js" %}
            {% endfor %}
        {% endif %}
        {% endset %}
        <script>
            {{ js | jsmin | safe }}
        </script>
    </body>
</html>
