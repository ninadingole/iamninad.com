---
title: "Offline"
permalink: offline.html
layout: layouts/default
route: error
statusPath: "~/offline"
css:
 - error-pages
---

<section class="ErrorPage">
  <div class="ErrorPage-Prompt">
    <span class="u">{{ site.profile.handle }}</span><span class="at">@</span><span class="h">{{ site.profile.host }}</span><span class="colon">:</span><span class="p">~</span><span class="dollar"> $ </span><span class="err">ping {{ site.domain }}</span>
  </div>

  <h1>you are offline</h1>
  <p>The network is unreachable. Reconnect and try again — your last cached pages should still load.</p>

  <pre class="ErrorPage-Codeblock"><span class="e">ping: cannot resolve {{ site.domain }}: Network is unreachable</span>
<span class="k">$</span> ifconfig | grep status
        <span class="e">status: inactive</span></pre>

  <p>
    <a href="/" class="Btn-Accent">./retry.sh</a>
  </p>
</section>
