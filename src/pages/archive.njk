---
title: "Archive"
excerpt: "every post in chronological order"
permalink: "/archive/index.html"
layout: layouts/default
route: archive
statusPath: "~/posts/archive"
css:
  - post-list
---

{% set archive = collections.posts | groupByYear %}
{% set tags = collections.posts | tagCounts %}
{% set totalWords = collections.posts | totalWords %}
{% set totalRead = collections.posts | totalReadMin %}

<div class="ArchiveHead">
  <span class="u">{{ site.profile.handle }}</span><span class="at">@</span><span class="h">{{ site.profile.host }}</span><span class="colon">:</span><span class="p">~/posts</span><span class="dollar"> $ </span><span class="cmd">find . -name "*.md" | sort -r</span>
</div>

<h1 class="ArchiveTitle"># archive</h1>
<div class="ArchiveSubtitle">
  every post in chronological order · {{ collections.posts.length }} files · {{ (totalWords / 1000) | round }}k words
</div>

<section class="Stats">
  <div class="Stats-Item"><div class="lbl">posts</div><div class="val">{{ collections.posts.length }}</div></div>
  <div class="Stats-Item"><div class="lbl">words</div><div class="val">{{ totalWords }}</div></div>
  <div class="Stats-Item"><div class="lbl">read time</div><div class="val">{{ totalRead }}<span class="suf"> min</span></div></div>
  <div class="Stats-Item"><div class="lbl">tags</div><div class="val">{{ tags.length }}</div></div>
  <div class="Stats-Item"><div class="lbl">years</div><div class="val">{{ archive.length }}</div></div>
</section>

{# Heatmap data — rendered client-side from data-* on this element #}
<section class="Heatmap" id="heatmap" data-posts='[
{%- for p in collections.posts -%}
  {"d":"{{ p.date | iso_date }}"}{% if not loop.last %},{% endif %}
{%- endfor -%}
]'>
  <div class="Heatmap-Head">
    <div class="Heatmap-Label">./activity.sh --since={{ archive | last | first }}</div>
    <div class="Heatmap-Legend">
      <span>less</span>
      <span class="sw" style="opacity:.25"></span>
      <span class="sw" style="opacity:.45"></span>
      <span class="sw" style="opacity:.70"></span>
      <span class="sw" style="opacity:1"></span>
      <span>more</span>
    </div>
  </div>
  <div class="Heatmap-Grid" id="heatmap-grid"></div>
</section>

<section class="Filters">
  <div class="Filters-Label">$ jump_to / filter</div>
  <div class="Filters-Row">
    <span class="Filters-Hint">year</span>
    {% for item in archive %}
      <a href="#y-{{ item | first }}" class="Tag">{{ item | first }}</a>
    {% endfor %}
    <span class="Filters-Sep"></span>
    <span class="Filters-Hint">tag</span>
    {% for t in tags %}{% if loop.index <= 10 %}
      <a href="/tags/{{ t.name }}/" class="Tag">#{{ t.name }}<span class="count">{{ t.count }}</span></a>
    {% endif %}{% endfor %}
  </div>
</section>

{% for item in archive %}
  {% set year = item | first %}
  {% set yearPosts = item | last %}
  {% set yearWords = yearPosts | totalWords %}

  <section class="YearGroup" id="y-{{ year }}">
    <div class="YearGroup-Head">
      <h2 class="YearGroup-Title"><span class="hh">##</span>{{ year }}</h2>
      <div class="YearGroup-Stats">
        {{ yearPosts.length }} {% if yearPosts.length == 1 %}post{% else %}posts{% endif %} · {{ yearWords }} words
      </div>
    </div>
    <div class="YearList PostList">
      {% for p in yearPosts %}
        <a class="PostRow" href="{{ p.url }}">
          <span class="date">{{ p.date | iso_date }}</span>
          <span class="len">{{ p.templateContent | readMinutes }}min</span>
          <div>
            <div class="title">{{ p.data.title }}</div>
            <div class="tags">
              {% for tg in p.data.tags %}{% if tg != 'posts' and loop.index <= 4 %}
                <span class="TagInline">#{{ tg }}</span>
              {% endif %}{% endfor %}
            </div>
          </div>
          <span class="arrow">→</span>
        </a>
      {% endfor %}
    </div>
  </section>
{% endfor %}

<div class="EndMarker">
  <span class="eof">EOF</span>
  <span> — end of the archive. thanks for reading.</span>
</div>
